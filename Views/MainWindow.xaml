<Window x:Class="RGZ_TIMP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Визуализатор сортировки"
        Height="760"
        Width="1450"
        WindowStartupLocation="CenterScreen"
        Background="#EAEAEA">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>

        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="0" Margin="10" Background="#F5F5F5" CornerRadius="15" BorderBrush="#D0D0D0" BorderThickness="1">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <!-- Ввод -->
                    <ColumnDefinition Width="110"/>
                    <!-- Загрузить -->
                    <ColumnDefinition Width="110"/>
                    <!-- Сохранить -->
                    <ColumnDefinition Width="140"/>
                    <!-- Генерация -->
                    <ColumnDefinition Width="180"/>
                    <!-- Комбобокс -->
                    <ColumnDefinition Width="100"/>
                    <!-- Старт -->
                    <ColumnDefinition Width="100"/>
                    <!-- Пауза -->
                    <ColumnDefinition Width="100"/>
                    <!-- Сброс -->
                    <ColumnDefinition Width="110"/>
                    <!-- Справка -->
                    <ColumnDefinition Width="80"/>
                    <!-- Текст скорости -->
                    <ColumnDefinition Width="*"/>
                    <!-- Ползунок -->
                </Grid.ColumnDefinitions>

                <!-- ВВОД -->
                <TextBox x:Name="ArrayTextBox" Grid.Column="0" Height="40" Margin="5" FontSize="16" VerticalContentAlignment="Center"/>

                <!-- ЗАГРУЗИТЬ -->
                <Button x:Name="LoadButton" Grid.Column="1" Content="ЗАГРУЗИТЬ" Height="40" Margin="5" FontSize="13" FontWeight="Bold" Background="#9C27B0" Foreground="White"/>

                <!-- СОХРАНИТЬ -->
                <Button x:Name="SaveButton" Grid.Column="2" Content="СОХРАНИТЬ" Height="40" Margin="5" FontSize="13" FontWeight="Bold" Background="#AB47BC" Foreground="White"/>

                <!-- ГЕНЕРАЦИЯ -->
                <Button x:Name="GenerateButton" Grid.Column="3" Content="ГЕНЕРАЦИЯ" Height="40" Margin="5" FontSize="13" FontWeight="Bold" Background="#66BB6A" Foreground="White"/>

                <!-- ВЫБОР АЛГОРИТМА -->
                <ComboBox x:Name="AlgorithmComboBox" Grid.Column="4" Height="40" Margin="5" FontSize="15">
                    <ComboBoxItem Content="Пузырьковая"/>
                    <ComboBoxItem Content="Выбором"/>
                    <ComboBoxItem Content="Вставками"/>
                    <ComboBoxItem Content="Быстрая"/>
                </ComboBox>

                <!-- СТАРТ -->
                <Button x:Name="StartButton" Grid.Column="5" Content="СТАРТ" Height="40" Margin="5" FontSize="13" FontWeight="Bold" Background="#42A5F5" Foreground="White"/>

                <!-- ПАУЗА -->
                <Button x:Name="PauseButton" Grid.Column="6" Content="ПАУЗА" Height="40" Margin="5" FontSize="13" FontWeight="Bold" Background="#FFA726" Foreground="White"/>

                <!-- СБРОС -->
                <Button x:Name="ResetButton" Grid.Column="7" Content="СБРОС" Height="40" Margin="5" FontSize="13" FontWeight="Bold" Background="#EF5350" Foreground="White"/>

                <!-- СПРАВКА -->
                <Button x:Name="HelpButton" Grid.Column="8" Content="СПРАВКА" Height="40" Margin="5" FontSize="13" FontWeight="Bold" Background="#78909C" Foreground="White"/>

                <!-- ТЕКСТ -->
                <TextBlock Grid.Column="9" Text="Скорость" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>

                <!-- ПОЛЗУНОК -->
                <Slider x:Name="SpeedSlider" Grid.Column="10" Margin="10 0" Minimum="10" Maximum="1000" Value="100" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ОБЛАСТЬ ВИЗУАЛИЗАЦИИ -->

        <Border Grid.Row="1"
                Margin="10"
                Background="#F5F5F5"
                CornerRadius="15"
                BorderBrush="#D0D0D0"
                BorderThickness="1">

            <Canvas x:Name="ChartCanvas"
                    Margin="10"
                    Background="#F5F5F5"/>

        </Border>

        <!-- НИЖНЯЯ ПАНЕЛЬ -->

        <Border Grid.Row="2"
                Margin="10"
                Background="#F5F5F5"
                CornerRadius="15"
                BorderBrush="#D0D0D0"
                BorderThickness="1">

            <Grid>

                <TextBlock x:Name="StatsTextBlock"
                           Margin="20 0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="Black"/>

            </Grid>

        </Border>

    </Grid>

</Window>
